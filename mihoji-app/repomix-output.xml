/* eslint-disable @next/next/no-html-link-for-pages */
'use client';

import { CircleHelp, Download, HardDrive, Infinity as InfinityIcon, Network, Server, Sparkles, Users, X } from 'lucide-react';
import { useState } from 'react';
import { SignatureCard } from '@/components/ui/signature-card';
import { formatAmount, formatBytes, formatCredits, formatDate, formatDateTime } from '@/lib/format';
import { plans, type Plan } from '@/lib/plans';
import type { CreditBalance, Invoice, Subscription, UsageSnapshot } from '@/lib/billing/types';

type Tab = 'subscription' | 'plans' | 'invoices';
const resourceMeta = [{ key: 'publishedApps', label: 'Sites en ligne', icon: Network }, { key: 'cloudActions', label: 'Actions cloud', icon: Sparkles }, { key: 'fileStorage', label: 'Stockage de fichiers', icon: HardDrive }, { key: 'database', label: 'Utilisation de la base', icon: Server }, { key: 'apiCalls', label: 'Appels API serveur', icon: Users }] as const;

function PlanPill({ plan }: { plan: Plan }) { return <span className={`rounded-md px-2 py-0.5 text-xs ${plan.tone === 'amber' ? 'bg-amber-500/10 text-amber-300' : plan.tone === 'lime' ? 'bg-lime-500/10 text-lime-300' : plan.tone === 'violet' ? 'bg-violet-500/10 text-violet-300' : 'bg-slate-700 text-slate-300'}`}>{plan.name}</span>; }
function Meter({ used, limit }: { used: number; limit: number }) { if (!Number.isFinite(limit)) return <div className="mt-3 flex items-center gap-1 text-xs text-slate-500"><InfinityIcon className="h-3 w-3" />Unlimited</div>; const ratio = limit ? used / limit : 0; const color = ratio >= 0.9 ? 'bg-rose-400' : ratio >= 0.75 ? 'bg-amber-400' : 'bg-indigo-500'; return <div className="mt-3 h-1.5 rounded-full bg-slate-800" role="meter" aria-valuenow={used} aria-valuemin={0} aria-valuemax={limit}><div className={`h-full rounded-full ${color}`} style={{ width: `${Math.min(100, Math.max(ratio * 100, used > 0 ? 1 : 0))}%` }} /></div>; }

export function BillingView({ balance, subscription, usage, invoices }: { balance: CreditBalance; subscription: Subscription; usage: UsageSnapshot; invoices: Invoice[] }) {
  const [tab, setTab] = useState<Tab>('subscription');
  const current = plans.find((plan) => plan.id === subscription.planId) || plans[1];
  return <div><div className="mb-8 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between"><div><p className="text-sm font-medium text-indigo-400">Réglages de l&apos;espace</p><h1 className="mt-2 text-3xl font-bold tracking-tight">Facturation</h1><p className="mt-2 text-sm text-slate-400">Gérez votre formule, votre utilisation et vos factures.</p></div><a href="/studio/demo/preview" className="w-fit rounded-lg border border-slate-700 px-4 py-2 text-sm text-slate-300 hover:border-slate-500 hover:text-white">Retour au Studio</a></div><div className="mb-7 flex gap-6 border-b border-slate-800">{([['subscription', 'Votre formule'], ['plans', 'Formules'], ['invoices', 'Factures']] as const).map(([id, label]) => <button key={id} type="button" onClick={() => setTab(id)} className={`border-b-2 px-1 pb-3 text-sm font-medium ${tab === id ? 'border-indigo-500 text-slate-50' : 'border-transparent text-slate-500 hover:text-slate-200'}`} aria-current={tab === id ? 'page' : undefined}>{label}</button>)}</div>{tab === 'subscription' && <div className="space-y-6"><div className="grid gap-5 md:grid-cols-2"><SignatureCard className="p-6"><div className="flex items-start justify-between"><div><p className="text-sm text-slate-400">Votre formule</p><h2 className="mt-2 text-2xl font-bold">{current.name}</h2></div><p className="text-2xl font-bold tabular-nums">{formatAmount(current.price, true)}</p></div><div className="mt-12 flex items-end justify-between gap-4"><p className="text-xs leading-5 text-slate-500">Renouvellement le {formatDate(subscription.periodEnd)}</p><button type="button" className="rounded-lg border border-slate-600 px-3 py-2 text-xs font-medium text-slate-300 hover:border-slate-400 hover:text-white">Gérer</button></div></SignatureCard><SignatureCard className="p-6"><div className="flex items-start justify-between"><div><p className="text-sm text-slate-400">Crédits restants</p><h2 className="mt-2 text-2xl font-bold tabular-nums">{formatCredits(balance.remaining)}</h2></div><Sparkles className="h-5 w-5 text-indigo-400" /></div><p className="mt-10 text-xs text-slate-500">{formatCredits(current.credits)} crédits renouvelés le {formatDateTime(balance.resetAt)}</p><button type="button" className="mt-4 rounded-lg bg-indigo-600 px-4 py-2 text-xs font-semibold text-white hover:bg-indigo-500">Acheter des crédits</button></SignatureCard></div><SignatureCard className="grid divide-y divide-slate-700 p-0 md:grid-cols-5 md:divide-x md:divide-y-0">{resourceMeta.map(({ key, label, icon: Icon }) => { const resource = usage[key]; return <div key={key} className="p-4"><div className="flex items-center gap-2 text-[10px] font-semibold uppercase tracking-wider text-slate-500"><Icon className="h-3.5 w-3.5 text-indigo-300" />{label}<CircleHelp className="ml-auto h-3 w-3" /></div><p className="mt-4 text-sm font-semibold tabular-nums text-slate-100">{key === 'fileStorage' || key === 'database' ? `${formatBytes(resource.used)} sur ${formatBytes(resource.limit)}` : Number.isFinite(resource.limit) ? `${resource.used.toLocaleString('fr-FR')} sur ${resource.limit.toLocaleString('fr-FR')}` : 'Illimité'}</p><p className="mt-1 text-xs text-slate-500">{key === 'publishedApps' || key === 'fileStorage' ? 'depuis le début' : 'ce mois-ci'}</p><Meter used={resource.used} limit={resource.limit} /></div>; })}</SignatureCard></div>}{tab === 'plans' && <PlansGrid />}{tab === 'invoices' && <InvoicesTable invoices={invoices} />}</div>;
}

function PlansGrid() { const [team, setTeam] = useState(false); return <div><div className="mb-5 flex flex-wrap items-center justify-between gap-3"><div className="flex rounded-lg border border-slate-800 p-1"><button type="button" onClick={() => setTeam(false)} className={`rounded-md px-3 py-1.5 text-xs ${!team ? 'bg-slate-800 text-white' : 'text-slate-500'}`}>For you</button><button type="button" onClick={() => setTeam(true)} className={`rounded-md px-3 py-1.5 text-xs ${team ? 'bg-slate-800 text-white' : 'text-slate-500'}`}>For your team</button></div><select aria-label="Currency" className="rounded-lg border border-slate-700 bg-slate-900 px-3 py-2 text-xs text-slate-300"><option>EUR</option><option>USD</option></select></div><div className="grid gap-4 md:grid-cols-2 xl:grid-cols-4">{plans.map((plan) => <div key={plan.id} className="rounded-xl bg-slate-900 p-5 ring-1 ring-slate-800"><PlanPill plan={plan} /><h2 className="mt-5 font-display text-3xl font-extrabold">{formatAmount(plan.price, true)}</h2><p className="mt-2 min-h-10 text-xs leading-5 text-slate-400">{plan.id === 'free' ? 'A simple way to explore Mihoji.' : plan.id === 'starter' ? 'For focused projects in motion.' : 'For teams building at scale.'}</p><div className="mt-5 rounded-lg bg-slate-800/60 p-3 text-xs text-slate-300"><p><strong>{formatCredits(plan.credits)}</strong> credits</p><p className="mt-2"><strong>{plan.publishedApps}</strong> published apps</p><p className="mt-2"><strong>{plan.agentUsage}</strong> agent usage</p></div><button type="button" className="mt-5 w-full rounded-lg border border-slate-700 px-3 py-2 text-xs font-semibold text-slate-300 hover:border-indigo-500 hover:text-white">Get started</button></div>)}</div><SignatureCard className="mt-8 overflow-hidden"><div className="border-b border-slate-700 p-5"><h2 className="text-lg font-semibold">What changes between plans?</h2></div><div className="divide-y divide-dashed divide-slate-700">{['Published apps', 'Credits', 'Usage via ChatGPT & Claude', 'Custom domains', 'Website traffic', 'File storage', 'Database usage', 'Backend API calls'].map((row) => <div key={row} className="grid grid-cols-[1fr_repeat(3,auto)] items-center gap-4 p-4 text-xs"><span className="font-medium text-slate-300">{row}</span><span className="text-slate-500">Starter</span><span className="text-slate-400">Pro</span><span className="text-slate-300">Max</span></div>)}</div></SignatureCard></div>; }
function InvoicesTable({ invoices }: { invoices: Invoice[] }) { return invoices.length ? <SignatureCard className="overflow-x-auto"><table className="w-full min-w-[720px] text-left text-xs"><thead className="bg-slate-800 text-slate-300"><tr>{['Date', 'Invoice', 'Product', 'Type', 'Credits', 'Status', 'Amount', ''].map((head) => <th key={head} className="px-4 py-3 font-medium">{head}</th>)}</tr></thead><tbody className="divide-y divide-slate-800">{invoices.map((invoice) => <tr key={invoice.number}><td className="px-4 py-4 text-slate-400">{formatDate(invoice.date)}</td><td className="px-4 py-4 font-mono text-slate-300">{invoice.number}</td><td className="px-4 py-4 text-slate-300">{invoice.product}</td><td className="px-4 py-4"><span className="rounded-md bg-indigo-500/10 px-2 py-1 text-indigo-300">{invoice.type === 'subscription' ? 'Subscription' : 'Credits'}</span></td><td className="px-4 py-4 tabular-nums text-slate-400">{formatCredits(invoice.credits)}</td><td className="px-4 py-4"><span className="rounded-md bg-emerald-500/10 px-2 py-1 text-emerald-300">{invoice.status}</span></td><td className="px-4 py-4 text-right font-mono text-slate-300">{formatAmount(invoice.amount)}</td><td className="px-4 py-4"><a href={invoice.pdfUrl} title="Download invoice" className="text-slate-500 hover:text-white"><Download className="h-4 w-4" /></a></td></tr>)}</tbody></table></SignatureCard> : <div className="rounded-xl bg-slate-900 p-8 text-center ring-1 ring-slate-800"><X className="mx-auto h-6 w-6 text-slate-600" /><p className="mt-3 text-sm text-slate-300">No invoices yet</p></div>; }
</file>

