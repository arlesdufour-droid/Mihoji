# Environment name. Use development for the current Supabase project and production for the separate EU project.
APP_ENV=development
# Supabase project URL and publishable browser key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Public application URL used in authentication emails. Do not use localhost in shared environments.
NEXT_PUBLIC_SITE_URL=
# PostgreSQL connection string. Keep it server-only.
DATABASE_URL=
# Supabase service role key. Never expose it to client code.
SUPABASE_SERVICE_ROLE_KEY=
# AI provider key; server-only.
GROQ_API_KEY=
# Set to 1 in development to force simulated AI answers even when GROQ_API_KEY is set (used by e2e tests). Never set in production.
AI_MOCK=
# Use a different Groq key in production; never copy the development key.
AI_MODEL_FAST=
AI_MODEL_STRONG=
AI_MODEL_FALLBACK=
# Comma-separated email addresses allowed to access the /admin back-office.
ADMIN_EMAILS=
E2B_API_KEY=
PUBLISHED_SITES_DOMAIN=sites.mihoji.app
VERCEL_TOKEN=
NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=false
BREVO_API_KEY=
MAILER_FROM_EMAIL=
MAILER_FROM_NAME=Mihoji
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
STRIPE_PRICE_FREE=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
STRIPE_PRICE_MAX=
# Unsplash (photos des sites générés) : https://unsplash.com/developers — clé « Access Key » ; server-only.
UNSPLASH_ACCESS_KEY=
# Anthropic (modèle de design pour la création et le changement de style des sites) ; server-only.
# Sans cette clé : repli sur le modèle fort de Groq (AI_MODEL_STRONG). Sans aucune clé : simulation en développement,
# erreur explicite « ai_not_configured » en production. AI_MOCK=1 force la simulation (développement uniquement).
ANTHROPIC_API_KEY=
# Modèle de design (défaut : claude-sonnet-5-5). Coût réel de chaque génération enregistré dans site_generations.shadow_cost_eur.
AI_MODEL_DESIGN=
